// Color values come from colors.rasi, generated by scripts/theme.py.
@import "colors"

* {
    highlight: bold;

    separatorcolor:              @border-color;

    normal-background:           transparent;
    normal-foreground:           @foreground;
    alternate-normal-background: transparent;
    alternate-normal-foreground: @foreground;
    selected-normal-background:  transparent;
    selected-normal-foreground:  @foreground;

    active-background:           @yellow;
    active-foreground:           @foreground;
    alternate-active-background: @yellow;
    alternate-active-foreground: @foreground;
    selected-active-background:  @yellow-light;
    selected-active-foreground:  @foreground;

    urgent-background:           @red-dark;
    urgent-foreground:           @foreground;
    alternate-urgent-background: @red-dark;
    alternate-urgent-foreground: @foreground;
    selected-urgent-background:  @red-light;
    selected-urgent-foreground:  @foreground;
}

entry {
    placeholder: "Search";
    placeholder-color: @entry-placeholder;
    hide-cursor-on-empty: true;
}

element-text {
    margin: 0px;
    padding: 0px 7px 0px 5px;
    vertical-align: 0.5;
}

element-text selected {
    margin: 0px;
    border: 0px;
    padding: 0px;
    border-radius: 4px;
    background-color: @selected-bg;
}

listview {
    margin: 0px 30px 0.5em 32px;
    border: 0px;
    padding: 0px;
    dynamic: true;
    fixed-height: false;
    require-input: true;
    spacing: 0px;
}

inputbar {
    margin: 0px;
    border: 0px;
    padding: 12px 12px;
    children: [prompt, entry];
}

prompt {
    padding: 0px 14px 0px 2px;
}

window {
    margin: 0px 50px;
    border: 0px;
    padding: 4px;

    border-radius: 23px;
    children: [mainbox];
    background-color: @background;
}

mainbox {
    spacing: 0;
    children: [ inputbar, listview ];
}

scrollbar {
    background-color: transparent;
    handle-color: transparent;
    handle-rounded-corners: true;
}
